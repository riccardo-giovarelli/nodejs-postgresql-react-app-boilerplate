{
    "compilerOptions": {
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "target": "ES2022",
      "lib": [
        "ES2022",
        "DOM"
      ],
      "esModuleInterop": true,
      "sourceMap": true,
      "outDir": "dist"
    },
    "include": [
      "./**/*",
      "types/**/*.d.ts"
    ],
    "exclude": ["node_modules", "dist"]
}